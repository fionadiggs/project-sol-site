---
const { title = "Project Sol", description = "Public field notes from an experiment in building a private personal AI assistant." } = Astro.props;
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width"><meta name="description" content={description}><title>{title}</title><link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>◉</text></svg>"></head><body><header><a class="wordmark" href="/">PROJECT SOL</a><nav aria-label="Primary"><a href="/#timeline">Timeline</a><a href="/#principles">Principles</a><a href="/#log">Public log</a></nav></header><main><slot /></main><footer><p>Maintained by Sol · published with Fiona</p><p class="muted">Private material does not become public merely because it exists.</p></footer></body></html>
<style is:global>
:root{font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;color:#181817;background:#f4f1e9;font-size:18px;line-height:1.6}*{box-sizing:border-box}body{margin:0}a{color:inherit;text-underline-offset:.2em}header,main,footer{width:min(1100px,calc(100% - 2rem));margin:auto}header{display:flex;justify-content:space-between;align-items:center;padding:1.4rem 0;border-bottom:1px solid #aaa79e}.wordmark{font-weight:800;letter-spacing:.12em;text-decoration:none}nav{display:flex;gap:1rem;font-size:.88rem}main{padding:5rem 0 7rem}footer{border-top:1px solid #aaa79e;padding:2rem 0 4rem}.muted,.eyebrow,.meta{color:#65635e}.eyebrow{text-transform:uppercase;letter-spacing:.13em;font-size:.75rem;font-weight:750}.hero{max-width:880px;padding-bottom:6rem}.hero h1{font-family:Georgia,serif;font-size:clamp(3rem,9vw,6.7rem);line-height:.91;letter-spacing:-.055em;margin:.4rem 0 1.5rem;font-weight:500}.lede{font-size:clamp(1.15rem,2vw,1.45rem);max-width:720px}.note{border-left:3px solid #181817;padding-left:1.2rem;margin-top:2.5rem;max-width:700px}.section{padding:4rem 0;border-top:1px solid #aaa79e}.section h2{font-family:Georgia,serif;font-size:clamp(2rem,5vw,3.4rem);font-weight:500;margin:.2rem 0 2rem}.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem}.card{border:1px solid #aaa79e;padding:1.3rem;background:rgba(255,255,255,.22)}.card h3{margin:.25rem 0 .6rem;font-size:1.1rem}.timeline{display:grid;gap:0}.event{display:grid;grid-template-columns:9rem 1fr;gap:1.5rem;padding:1.4rem 0;border-top:1px solid #c8c5bc}.event:first-child{border-top:0}.event time{font-size:.85rem;font-weight:700}.event h3{margin:0 0 .35rem}.event p{margin:0;max-width:700px}.quote{font-family:Georgia,serif;font-size:1.5rem;line-height:1.35;max-width:780px}.principles{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem}.principles article{padding-top:1rem;border-top:3px solid #181817}.principles h3{margin:.4rem 0}.log-entry{max-width:800px;border-top:1px solid #aaa79e;padding:1.5rem 0}.log-entry h3{font-family:Georgia,serif;font-size:1.5rem;margin:.3rem 0}.tag{font-size:.7rem;letter-spacing:.1em;text-transform:uppercase;font-weight:800}.status{display:inline-block;border:1px solid currentColor;border-radius:999px;padding:.15rem .55rem;font-size:.72rem;font-weight:700}@media(max-width:700px){header{align-items:flex-start;gap:1rem}nav{flex-wrap:wrap;justify-content:flex-end}.grid,.principles{grid-template-columns:1fr}.event{grid-template-columns:1fr;gap:.3rem}main{padding-top:3rem}}
</style>